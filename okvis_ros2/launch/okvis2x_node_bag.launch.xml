<launch>
    <!-- OKVIS2-X with volumetric submapping, reading a ROS2 bag directly (no `ros2 bag play`).
         Depth comes from the stereo network (TensorRT engine or TorchScript model).
         Example:
           ros2 launch okvis okvis2x_node_bag.launch.xml \
             config_filename:=$HOME/code/OKVIS2-X/config/uhumans2/okvis2.yaml \
             se_config_filename:=$HOME/code/OKVIS2-X/config/uhumans2/se2.yaml \
             path:=$HOME/Data/vi_slam/uhumans2 \
             imu_topic:=/tesse/imu/noisy/imu \
             cam_topics:="['/tesse/left_cam/rgb/image_raw', '/tesse/right_cam/rgb/image_raw']" \
             ground_truth_topic:=/tesse/odom -->

    <arg name="config_filename" default=""/>
    <arg name="se_config_filename" default=""/>
    <arg name="path" default=""/>            <!-- the bag directory, the one with metadata.yaml -->
    <arg name="csv_path" default=""/>        <!-- empty: next to the bag -->
    <arg name="start_delay" default="0.0"/>
    <!-- ROS2 bag topics; remapping does not apply when reading a bag file -->
    <arg name="imu_topic" default="/okvis/imu0"/>
    <arg name="cam_topics" default="['/okvis/cam0/image_raw', '/okvis/cam1/image_raw']"/>
    <arg name="depth_topics" default="[]"/>  <!-- normally empty: the depth is predicted -->
    <arg name="ground_truth_topic" default=""/>
    <!-- mapping -->
    <arg name="mesh_cutoff_z" default="2.5"/>
    <arg name="save_submap_meshes" default="false"/>
    <!-- visualisation -->
    <arg name="rerun" default="true"/>
    <arg name="rerun_url" default=""/>
    <arg name="show_images" default="true"/>
    <arg name="rviz" default="false"/>
    <arg name="mesh" default="realsense.dae"/>
    <!-- Add mesh for RVIZ visualization. In case you are using a different mesh, you will have to
         adjust the IMU-to-body extrinsics (T_BS) in the okvis2 config file -->

    <set_env name="OMP_NUM_THREADS" value="2"/>

    <node pkg="okvis" exec="okvis2x_stereo_network_node_bag" name="okvis" namespace="okvis">
        <param name="config_filename" value="$(var config_filename)"/>
        <param name="se_config_filename" value="$(var se_config_filename)"/>
        <param name="path" value="$(var path)"/>
        <param name="csv_path" value="$(var csv_path)"/>
        <param name="start_delay" value="$(var start_delay)"/>
        <param name="imu_topic" value="$(var imu_topic)"/>
        <param name="cam_topics" value="$(var cam_topics)"/>
        <param name="depth_topics" value="$(var depth_topics)"/>
        <param name="ground_truth_topic" value="$(var ground_truth_topic)"/>
        <param name="mesh_cutoff_z" type="float" value="$(var mesh_cutoff_z)"/>
        <param name="save_submap_meshes" value="$(var save_submap_meshes)"/>
        <param name="rerun" value="$(var rerun)"/>
        <param name="rerun_url" value="$(var rerun_url)"/>
        <param name="show_images" value="$(var show_images)"/>
        <param name="mesh_file" value="file://$(find-pkg-share okvis)/resources/meshes/$(var mesh)"/>
    </node>

    <node pkg="rviz2" exec="rviz2" name="rviz2" namespace="okvis"
          args="-d $(find-pkg-share okvis)/config/rviz2/rviz2_okvis2x_config.rviz"
          if="$(var rviz)"/>

</launch>
